# .editorconfig — https://editorconfig.org
# Hält Indentation, Encoding und Line-Endings konsistent über IDEs hinweg.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{js,mjs,html,css,json,webmanifest}]
indent_size = 2

[*.py]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
# Markdown nutzt manchmal zwei trailing spaces für harten Zeilenumbruch.
trim_trailing_whitespace = false

[*.sh]
indent_size = 4
